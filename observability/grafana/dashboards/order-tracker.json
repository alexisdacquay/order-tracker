{
  "uid": "order-tracker",
  "title": "Order Tracker",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "type": "table",
      "title": "Requests by route and status (since app start)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route, http_response_status_code) (http_server_request_duration_seconds_count)",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Route"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "http_request_method": 0,
              "http_route": 1,
              "http_response_status_code": 2,
              "Value": 3
            },
            "renameByName": {
              "http_request_method": "Method",
              "http_route": "Route",
              "http_response_status_code": "Status",
              "Value": "Requests"
            }
          }
        }
      ],
      "id": 1
    },
    {
      "type": "table",
      "title": "Errors by route and status (since app start)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route, http_response_status_code) (http_server_request_duration_seconds_count{http_response_status_code=~\"4..|5..\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Route"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "http_request_method": 0,
              "http_route": 1,
              "http_response_status_code": 2,
              "Value": 3
            },
            "renameByName": {
              "http_request_method": "Method",
              "http_route": "Route",
              "http_response_status_code": "Status",
              "Value": "Requests"
            }
          }
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Request rate by status (per second)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx) by route (per second)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent logs",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"order-tracker\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
